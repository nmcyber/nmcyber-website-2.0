generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ResourceAsset {
  id           String             @id @default(uuid())
  slug         String             @unique
  title        String
  description  String?
  storageKey   String
  mimeType     String
  sizeBytes    Int
  active       Boolean            @default(true)
  maxDownloads Int?
  accessTags   String[]           @default([])
  retentionDays Int?

  createdAt    DateTime           @default(now()) @db.Timestamptz
  updatedAt    DateTime           @updatedAt @db.Timestamptz

  requests     ResourceRequest[]
}

model ResourceRequest {
  id              String                  @id @default(uuid())
  assetId         String
  emailHash       String
  emailEncrypted  Bytes
  consentVersion  String
  requestIp       String?
  status          ResourceRequestStatus   @default(PENDING_VERIFICATION)
  firstSentAt     DateTime?               @db.Timestamptz
  lastSentAt      DateTime?               @db.Timestamptz
  downloadCount   Int                     @default(0)
  lastDownloadAt  DateTime?               @db.Timestamptz
  metadata        Json?

  createdAt       DateTime                @default(now()) @db.Timestamptz
  updatedAt       DateTime                @updatedAt @db.Timestamptz

  asset           ResourceAsset           @relation(fields: [assetId], references: [id])
  tokens          ResourceToken[]

  @@index([assetId])
  @@index([emailHash])
}

model ResourceToken {
  id          String      @id @default(uuid())
  requestId   String
  tokenHash   String      @unique
  expiresAt   DateTime    @db.Timestamptz
  maxUses     Int         @default(1)
  useCount    Int         @default(0)
  revokedAt   DateTime?   @db.Timestamptz
  audit       Json?

  createdAt   DateTime    @default(now()) @db.Timestamptz
  updatedAt   DateTime    @updatedAt @db.Timestamptz

  request     ResourceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([expiresAt])
}

enum ResourceRequestStatus {
  PENDING_VERIFICATION
  READY_TO_SEND
  LINK_SENT
  REJECTED_DISPOSABLE
  REJECTED_INVALID
  REJECTED_RATE_LIMIT
  FULFILLED
}
